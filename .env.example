# Copy this file to .env, then fill in the Feishu app credentials.
#
# The wrapper script loads this file before starting the local Hermes gateway.

# Local Hermes checkout. Replace this with your local clone path.
HERMES_AGENT_DIR=$HOME/path/to/hermes-agent
HERMES_PYTHON=$HERMES_AGENT_DIR/venv/bin/python

# Reuse your existing Hermes profile/config/auth.
HERMES_HOME=$HOME/.hermes

# Feishu app credentials from https://open.feishu.cn/
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Use "feishu" for China Feishu, or "lark" for Lark international.
FEISHU_DOMAIN=feishu

# Recommended: websocket does not require exposing a local HTTP port.
FEISHU_CONNECTION_MODE=websocket

# Start strict. Unknown DM users can pair and be approved with:
#   hermes pairing approve feishu <code>
FEISHU_ALLOW_ALL_USERS=false
FEISHU_ALLOWED_USERS=

# Optional. For scheduled notifications / cron delivery.
FEISHU_HOME_CHANNEL=

# Group behavior. "true" means Hermes only reacts when @mentioned in groups.
FEISHU_REQUIRE_MENTION=true

# Webhook-only settings. Leave these unused for websocket mode.
FEISHU_WEBHOOK_HOST=127.0.0.1
FEISHU_WEBHOOK_PORT=8765
FEISHU_WEBHOOK_PATH=/feishu/webhook
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
